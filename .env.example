PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=messagerie_web
DB_SSL=false
# Hosted MySQL with its own certificate authority (Aiven…): path to a .pem file, or the PEM text on one line with \n
DB_SSL_CA=
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_MINUTES=60
BCRYPT_ROUNDS=12
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10
CORS_ORIGIN=http://127.0.0.1:5500
